configuration {
    modes:              "drun";
    sorting-method:     "normal";
    matching:           "regex";
    drun-match-fields:  "name";
    display-drun:       "Launch:";
    drun {
        show-icons: true;
    }
    run {
        show-icons: false;
    }
    filebrowser {
        show-icons: true;
    }
}

@theme "catppuccin-mocha"

* {
    font:             "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color:       @text;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

/* ===== Window ===== */
window {
    location:         center;
    width:            500px;
    y-offset:         -20px;
    border-radius:    0px;
    border:           2px solid;
    border-color:     @lavender;
    background-color: @base;
}

/* ===== Main container ===== */
mainbox {
    padding:          0px;
    background-color: @base;
}

/* ===== Input bar ===== */
inputbar {
    background-color: @mantle;
    border-radius:    0px;
    border:           0px 0px 1px 0px solid;
    border-color:     @surface0;
    padding:          10px 16px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @text;
    background-color: transparent;
}

entry {
    text-color:       @text;
    placeholder:      "Enter";
    placeholder-color:@overlay0;
    background-color: transparent;
    cursor:           text;
}

/* ===== List ===== */
listview {
    background-color: @base;
    padding:          8px 0px;
    margin:           0px;
    columns:          1;
    lines:            6;
    fixed-height:     true;
    scrollbar:        false;
}

/* ===== Elements ===== */
element {
    padding:          9px 12px;
    spacing:          10px;
    border-radius:    0px;
    margin:           0px 8px;
    background-color: transparent;
    cursor:           pointer;
}

element normal urgent {
    text-color:       @red;
}

element normal active {
    text-color:       @blue;
}

element selected normal,
element selected active,
element selected urgent {
    background-color: @surface0;
    text-color:       @lavender;
}

element alternate normal,
element alternate active,
element alternate urgent {
    background-color: transparent;
}

/* ===== Icons & text ===== */
element-icon {
    size:             2.4em;
    vertical-align:   0.5;
    background-color: transparent;
}

element-text {
    text-color:       inherit;
    background-color: transparent;
    vertical-align:   0.5;
}

/* ===== Scrollbar ===== */
scrollbar {
    handle-color:     @surface1;
    handle-width:     4px;
    background-color: @mantle;
    border-radius:    0px;
}

/* ===== Message box ===== */
message {
    margin:           8px 8px 0px;
    border-radius:    0px;
    border:           1px solid;
    border-color:     @surface0;
    background-color: @mantle;
}

textbox {
    padding:          8px 16px;
    background-color: transparent;
    text-color:       @subtext1;
}
