configuration {
    modes:              "drun";
    sorting-method:     "normal";
    matching:           "regex";
    drun-match-fields:  "name";
    display-drun:       "Launch:";

    drun {
        show-icons: true;
    }

    run {
        show-icons: true;
    }

    filebrowser {
        show-icons: true;
    }
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Theme
 * ═══════════════════════════════════════════════════════════════════════════ */

@import "~/.config/rofi/colors.rasi"


/* ═══════════════════════════════════════════════════════════════════════════
 * Global
 * ═══════════════════════════════════════════════════════════════════════════ */

* {
    font:             "JetBrainsMono Nerd Font 12";

    background-color: transparent;
    text-color:       @text;
    separator-style: none;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Window
 * ═══════════════════════════════════════════════════════════════════════════ */

window {
    location:         center;

    width:            500px;
    y-offset:         -20px;

    border:           2px;
    border-color:     @accent;

    border-radius:    0px;

    background-color: @background;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Main container
 * ═══════════════════════════════════════════════════════════════════════════ */

mainbox {
    padding:          0px;
    spacing:          0px;

    background-color: @background;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Input bar
 * ═══════════════════════════════════════════════════════════════════════════ */

inputbar {
    padding:          10px 16px;
    spacing:          8px;

    background-color: @backgroundSecondary;

    border:           0px 0px 1px 0px;
    border-color:     @surface;

    children:         [ prompt, entry ];
 }


/* Prompt */
prompt {
    background-color: transparent;
    text-color:       @accent;
}


/* Search entry */
entry {
    background-color: transparent;

    text-color:       @text;

    placeholder:      "Search…";
    placeholder-color: @textMuted;

    cursor:            text;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Application list
 * ═══════════════════════════════════════════════════════════════════════════ */

listview {
    background-color: @background;

    padding:          8px 0px;
    margin:           0px;

    columns:          1;
    lines:            6;

    fixed-height:     true;
    border:           none;
    scrollbar:        false;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Elements
 * ═══════════════════════════════════════════════════════════════════════════ */

element {
    padding:          9px 12px;
    spacing:          10px;
    margin:           0px 8px;

    border-radius:    0px;

    background-color: transparent;

    cursor:           pointer;
}


/* ─────────────────────────────────────────────────────────────────────────
 * Normal
 * ───────────────────────────────────────────────────────────────────────── */

element normal.normal {
    background-color: transparent;
    text-color:       @text;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @text;
}


/* ─────────────────────────────────────────────────────────────────────────
 * Urgent
 * ───────────────────────────────────────────────────────────────────────── */

element normal.urgent {
    background-color: transparent;
    text-color:       @danger;
}

element alternate.urgent {
    background-color: transparent;
    text-color:       @danger;
}


/* ─────────────────────────────────────────────────────────────────────────
 * Active
 * ───────────────────────────────────────────────────────────────────────── */

element normal.active {
    background-color: transparent;
    text-color:       @info;
}

element alternate.active {
    background-color: transparent;
    text-color:       @info;
}


/* ─────────────────────────────────────────────────────────────────────────
 * Selected
 * ───────────────────────────────────────────────────────────────────────── */

element selected.normal {
    background-color: @surface;
    text-color:       @accent;
}

element selected.active {
    background-color: @surface;
    text-color:       @accent;
}

element selected.urgent {
    background-color: @surface;
    text-color:       @danger;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Icons
 * ═══════════════════════════════════════════════════════════════════════════ */

element-icon {
    size:             2.4em;

    background-color: transparent;

    vertical-align:   0.5;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Element text
 * ═══════════════════════════════════════════════════════════════════════════ */

element-text {
    background-color: transparent;

    text-color:       inherit;

    vertical-align:   0.5;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Scrollbar
 * ═══════════════════════════════════════════════════════════════════════════ */

scrollbar {
    handle-color:     @surfaceSecondary;
    handle-width:     4px;

    background-color: @backgroundSecondary;

    border-radius:    0px;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Message box
 * ═══════════════════════════════════════════════════════════════════════════ */

message {
    margin:           8px 8px 0px;

    border:           1px;
    border-color:     @surface;

    background-color: @backgroundSecondary;
}


/* Message text */
textbox {
    padding:          8px 16px;

    background-color: transparent;

    text-color:       @textSecondary;
}
