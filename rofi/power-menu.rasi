/**
 * Rofi Power Menu
 * Uses the same palette as the main Rofi config
 */

@import "~/.config/rofi/colors.rasi"

* {
    font:             "JetBrainsMono Nerd Font 13";

    background-color: transparent;
    text-color:       @text;

    margin:           0px;
    padding:          0px;
    spacing:          0px;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Window
 * ═══════════════════════════════════════════════════════════════════════════ */

window {
    location:         center;

    width:            240px;

    border:           2px;
    border-color:     @accent;
    border-radius:    0px;

    background-color: @background;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Main container
 * ═══════════════════════════════════════════════════════════════════════════ */

mainbox {
    children:         [ listview ];

    padding:          8px 0px;

    background-color: @background;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * List
 * ═══════════════════════════════════════════════════════════════════════════ */

listview {
    background-color: @background;

    padding:          0px;
    margin:           0px;

    columns:          1;
    lines:            6;

    fixed-height:     false;
    scrollbar:        false;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Elements
 * ═══════════════════════════════════════════════════════════════════════════ */

element {
    padding:          9px 12px;
    spacing:          10px;
    margin:           0px 8px;

    border-radius:    0px;

    cursor:           pointer;

    background-color: transparent;
}


/* Normal */

element normal.normal {
    background-color: @background;
    text-color:       @text;
}


/* Alternate */

element alternate.normal {
    background-color: @backgroundSecondary;
    text-color:       @text;
}


/* Selected */

element selected.normal {
    background-color: @surface;
    text-color:       @accent;
}


/* Urgent */

element normal.urgent {
    background-color: @background;
    text-color:       @danger;
}

element alternate.urgent {
    background-color: @backgroundSecondary;
    text-color:       @danger;
}

element selected.urgent {
    background-color: @surface;
    text-color:       @danger;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Icons & text
 * ═══════════════════════════════════════════════════════════════════════════ */

element-icon {
    size:             1.1em;

    vertical-align:   0.5;

    background-color: transparent;
    cursor:           pointer;
}

element-text {
    text-color:       inherit;

    vertical-align:   0.5;

    background-color: transparent;
    cursor:           pointer;
}
