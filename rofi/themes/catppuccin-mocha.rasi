/**
 * Catppuccin Mocha — rofi theme
 * Place at: ~/.config/rofi/themes/catppuccin-mocha.rasi
 * Reference with: @theme "catppuccin-mocha"  (or full path)
 */

* {
    /* ── Catppuccin Mocha palette ── */
    base:     #1e1e2e;
    mantle:   #181825;
    crust:    #11111b;
    surface0: #313244;
    surface1: #45475a;
    surface2: #585b70;
    overlay0: #6c7086;
    overlay1: #7f849c;
    overlay2: #9399b2;
    subtext0: #a6adc8;
    subtext1: #bac2de;
    text:     #cdd6f4;

    /* accents */
    lavender: #b4befe;
    blue:     #89b4fa;
    sapphire: #74c7ec;
    sky:      #89dceb;
    teal:     #94e2d5;
    green:    #a6e3a1;
    yellow:   #f9e2af;
    peach:    #fab387;
    maroon:   #eba0ac;
    red:      #f38ba8;
    mauve:    #cba6f7;
    pink:     #f5c2e7;
    flamingo: #f2cdcd;
    rosewater:#f5e0dc;

    /* ── Wiring ── */
    font:             "JetBrainsMono Nerd Font 13";
    background-color: transparent;
    text-color:       @text;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

/* ===== Window ===== */
window {
    location:         center;
    width:            500px;
    y-offset:         -20px;
    border-radius:    0px;
    border:           2px solid;
    border-color:     @mauve;
    background-color: @base;
}

/* ===== Main container ===== */
mainbox {
    padding:          0px;
    background-color: @base;
}

/* ===== Input bar ===== */
inputbar {
    background-color: @mantle;
    border-radius:    0px;
    border:           0px 0px 1px 0px solid;
    border-color:     @surface0;
    padding:          10px 16px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @mauve;
    background-color: transparent;
}

entry {
    text-color:       @text;
    placeholder:      "search…";
    placeholder-color:@overlay0;
    background-color: transparent;
    cursor:           text;
}

/* ===== List ===== */
listview {
    background-color: @base;
    padding:          8px 0px;
    margin:           0px;
    columns:          1;
    lines:            6;
    fixed-height:     false;
    scrollbar:        false;
}

/* ===== Elements ===== */
element {
    padding:          9px 12px;
    spacing:          10px;

    margin:           0px 8px;
    background-color: transparent;
    cursor:           pointer;
}

element normal urgent {
    text-color:       @red;
}

element normal active {
    text-color:       @blue;
}

element selected normal,
element selected active,
element selected urgent {
    background-color: @surface0;
    text-color:       @lavender;
}

element alternate normal,
element alternate active,
element alternate urgent {
    background-color: transparent;
}

/* ===== Icons & text ===== */
element-icon {
    size:             1.1em;
    vertical-align:   0.5;
    background-color: transparent;
    cursor:           pointer;
}

element-text {
    text-color:       inherit;
    background-color: transparent;
    vertical-align:   0.5;
    cursor:           pointer;
}

/* ===== Scrollbar ===== */
scrollbar {
    handle-color:     @surface1;
    handle-width:     4px;
    background-color: @mantle;

}

/* ===== Message box ===== */
message {
    margin:           8px 8px 0px;

    border:           1px solid;
    border-color:     @surface0;
    background-color: @mantle;
}

textbox {
    padding:          8px 16px;
    background-color: transparent;
    text-color:       @subtext1;
}
