/**
 * Rofi WiFi Menu
 * Uses the same palette as the main Rofi config
 */

@import "~/.config/rofi/colors.rasi"

* {
    font:             "JetBrainsMono Nerd Font 12";

    background-color: transparent;
    text-color:       @text;

    margin:           0px;
    padding:          0px;
    spacing:          0px;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Window
 * ═══════════════════════════════════════════════════════════════════════════ */

window {
    location:         center;
    anchor:           center;

    width:            420px;

    border:           2px;
    border-color:     @accent;
    border-radius:    0px;

    background-color: @background;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Main container
 * ═══════════════════════════════════════════════════════════════════════════ */

mainbox {
    padding:          10px;
    spacing:          10px;

    background-color: @background;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Input bar
 * ═══════════════════════════════════════════════════════════════════════════ */

inputbar {
    padding:          8px 12px;
    spacing:          8px;

    background-color: @surface;

    border-radius:    0px;

    children:         [ prompt, entry ];
}


/* Prompt */

prompt {
    background-color: transparent;
    text-color:       @accent;
}


/* Entry */

entry {
    background-color: transparent;

    text-color:       @text;

    placeholder:      "Search networks...";
    placeholder-color: @textMuted;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * List
 * ═══════════════════════════════════════════════════════════════════════════ */

listview {
    background-color: transparent;

    lines:            10;
    spacing:          4px;

    scrollbar:        false;
    fixed-height:     false;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Elements
 * ═══════════════════════════════════════════════════════════════════════════ */

element {
    padding:          8px 12px;
    spacing:          8px;

    background-color: transparent;

    text-color:       @text;

    border-radius:    0px;
}


/* Normal */

element normal.normal {
    background-color: transparent;
    text-color:       @text;
}


/* Alternate */

element alternate.normal {
    background-color: @backgroundSecondary;
    text-color:       @text;
}


/* Selected */

element selected.normal {
    background-color: @surfaceSecondary;
    text-color:       @accent;

    border:           0px 0px 0px 3px;
    border-color:     @accent;

    border-radius:    0px;
}


/* Urgent */

element normal.urgent {
    background-color: transparent;
    text-color:       @danger;
}

element alternate.urgent {
    background-color: @backgroundSecondary;
    text-color:       @danger;
}

element selected.urgent {
    background-color: @surfaceSecondary;
    text-color:       @danger;

    border:           0px 0px 0px 3px;
    border-color:     @danger;

    border-radius:    0px;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Text
 * ═══════════════════════════════════════════════════════════════════════════ */

element-text {
    background-color: transparent;

    text-color:       inherit;

    vertical-align:   0.5;
}


/* ═══════════════════════════════════════════════════════════════════════════
 * Error
 * ═══════════════════════════════════════════════════════════════════════════ */

error-message {
    padding:          10px;

    background-color: @background;
    text-color:       @danger;

    border-radius:    0px;
}
