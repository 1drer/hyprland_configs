* {
    /* ═════════════════════════════════════════════
     * Backgrounds
     * ═════════════════════════════════════════════ */

    background:          #1e1e2e;
    backgroundSecondary: #181825;
    backgroundDeep:      #11111b;

    /* ═════════════════════════════════════════════
     * Surfaces
     * ═════════════════════════════════════════════ */

    surface:             #313244;
    surfaceSecondary:    #45475a;
    surfaceTertiary:     #585b70;

    /* ═════════════════════════════════════════════
     * Overlays
     * ═════════════════════════════════════════════ */

    overlay:             #6c7086;
    overlaySecondary:    #7f849c;
    overlayTertiary:     #9399b2;

    /* ═════════════════════════════════════════════
     * Text
     * ═════════════════════════════════════════════ */

    text:                #cdd6f4;
    textSecondary:       #bac2de;
    textMuted:           #a6adc8;

    /* ═════════════════════════════════════════════
     * Semantic accents
     * ═════════════════════════════════════════════ */

    accent:              #b4befe;
    accentSecondary:     #cba6f7;

    success:             #a6e3a1;
    warning:             #f9e2af;
    danger:              #f38ba8;
    info:                #89b4fa;
}
