* {
    /* ═════════════════════════════════════════════
     * Backgrounds
     * ═════════════════════════════════════════════ */

    background:          #282828;
    backgroundSecondary: #1d2021;
    backgroundDeep:      #1d2021;

    /* ═════════════════════════════════════════════
     * Surfaces
     * ═════════════════════════════════════════════ */

    surface:             #3c3836;
